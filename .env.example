# Solo para funciones de Vercel. Nunca subas los valores reales al repositorio.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
# Desarrollo local: usar una cuenta Firebase dedicada con permisos solo de lectura.
# No copiar credenciales de .vercel/.env.production.local.
OPS_READ_ONLY_MODE=1
# OPS_ADMIN_SECRET debe ser aleatorio, local y distinto de cualquier clave de producción.
OPS_ADMIN_SECRET=
# Configuración pública exclusiva para una vista previa aislada de Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
OFFICIAL_SNAPSHOT_OWNER_UID=
CRON_SECRET=
SNAPSHOT_AUTOMATION_ENABLED=false
# PremiumPay. Mantener desactivado hasta completar la revisión de lanzamiento.
PREMIUMPAY_ENVIRONMENT=test
PREMIUMPAY_CHECKOUT_ENABLED=false
PREMIUMPAY_API_KEY=
PREMIUMPAY_API_BASE_URL=
MONEYTRACKING_APP_ORIGIN=https://app.pronosticosmoneytips.com
# Solo controla si la tarjeta de compra se muestra en la app.
VITE_PREMIUMPAY_CHECKOUT_ENABLED=false
# Stripe Billing. Sandbox exclusivamente hasta que se autorice un despliegue.
STRIPE_BILLING_MODE=test
STRIPE_BILLING_ENABLED=false
VITE_STRIPE_BILLING_SANDBOX_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Transparencia pública en Telegram. Configurar exclusivamente en Vercel Production.
TELEGRAM_BOT_TOKEN=
TELEGRAM_PUBLIC_CHANNEL_ID=
TELEGRAM_PUBLIC_CHANNEL_USERNAME=
PUBLIC_APP_URL=https://app.pronosticosmoneytips.com

# API-Football / API-Sports (SportsDataProvider PoC)
API_FOOTBALL_KEY=
