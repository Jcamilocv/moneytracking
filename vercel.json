{
  "crons": [
    {
      "path": "/api/cron/refresh-official-snapshots",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/cron/settle-official-picks",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/settle-official-picks",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/cron/refresh-official-snapshots.js": {
      "maxDuration": 300
    },
    "api/cron/settle-official-picks.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/internal/futbolbrain-local-picks",
      "destination": "/api/admin/official-picks?mode=futbolbrain-local"
    },
    {
      "source": "/api/official-pick-reports",
      "destination": "/api/official-picks?mode=report"
    },
    {
      "source": "/api/admin/official-pick-reports",
      "destination": "/api/official-picks?mode=admin-reports"
    },
    {
      "source": "/api/payments/subscription-status",
      "destination": "/api/official-picks?mode=subscription-status"
    },
    {
      "source": "/api/payments/subscription-management",
      "destination": "/api/official-picks?mode=subscription-management"
    },
    {
      "source": "/api/payments/premiumpay/create",
      "destination": "/api/official-picks?mode=premiumpay-create"
    },
    {
      "source": "/api/payments/premiumpay/callback",
      "destination": "/api/official-picks?mode=premiumpay-callback"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://money-tracking-d908b.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://money-tracking-d908b.firebaseapp.com/__/firebase/:path*"
    }
  ]
}
