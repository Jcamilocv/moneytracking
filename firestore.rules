rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isMoneyTipsAdmin() {
      return request.auth != null
        && request.auth.uid == 'Rvp7qaQBC5RQwSKICRKnAb8vaI93';
    }

    function subscriptionPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/subscription;
    }

    // A MoneyTracKING workspace is part of Money Tips Premium. The payment
    // callback writes this entitlement with the Admin SDK, so it cannot be
    // created or extended from a browser.
    function hasPremiumWorkspaceAccess(userId) {
      return isMoneyTipsAdmin()
        || (isOwner(userId)
          && exists(subscriptionPath(userId))
          && get(subscriptionPath(userId)).data.status in ['active', 'trialing', 'past_due', 'cancel_at_period_end']
          && get(subscriptionPath(userId)).data.accessUntil is timestamp
          && get(subscriptionPath(userId)).data.accessUntil > request.time);
    }

    // Al acabar Premium, el usuario conserva lectura de sus bancas y apuestas
    // históricas, pero no puede crear ni alterar datos Premium.
    function hasHistoricalWorkspaceReadAccess(userId) {
      return isMoneyTipsAdmin() || isOwner(userId);
    }

    function shareOwnerPath(shareId) {
      return /databases/$(database)/documents/shareOwners/$(shareId);
    }

    function ownsShare(shareId) {
      return request.auth != null
        && exists(shareOwnerPath(shareId))
        && get(shareOwnerPath(shareId)).data.ownerUid == request.auth.uid;
    }

    function ownsShareAfterWrite(shareId) {
      return request.auth != null
        && existsAfter(shareOwnerPath(shareId))
        && getAfter(shareOwnerPath(shareId)).data.ownerUid == request.auth.uid;
    }

    function isValidShareOwner() {
      return request.auth != null
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    function isValidPublicShare() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'createdAt',
          'bank',
          'betCount'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.betCount is int
        && request.resource.data.betCount >= 0
        && request.resource.data.betCount <= 5000
        && request.resource.data.bank is map
        && request.resource.data.bank.keys().hasOnly([
          'id', 'name', 'initialCapital', 'currency', 'isBalance', 'bankIds'
        ])
        && request.resource.data.bank.id is string
        && request.resource.data.bank.name is string
        && request.resource.data.bank.initialCapital is number
        && request.resource.data.bank.currency is string
        && request.resource.data.bank.isBalance is bool
        && request.resource.data.bank.bankIds is list;
    }

    function isValidPublicBet() {
      return request.resource.data.keys().hasOnly([
          'id', 'bankId', 'date', 'time', 'bookmaker', 'betMode', 'title',
          'selection', 'status', 'category', 'odds', 'amount', 'stake',
          'isBack', 'isLive', 'isFreebet', 'cashout', 'isEachWay',
          'tipster', 'bonus', 'commission', 'selections'
        ])
        && request.resource.data.id is string
        && request.resource.data.bankId is string
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.status is string
        && request.resource.data.status != 'pending'
        && request.resource.data.odds is number
        && request.resource.data.amount is number
        && request.resource.data.stake is number
        && request.resource.data.selections is list;
    }

    function isValidAppBonosState() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'legacyUserId',
          'clientUpdatedAt',
          'migratedAt',
          'payload'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.legacyUserId is string
        && request.resource.data.clientUpdatedAt is int
        && request.resource.data.migratedAt == request.time
        && request.resource.data.payload is map;
    }

    function isValidAdminCrm() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'clientUpdatedAt',
          'updatedAt',
          'crmData'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.clientUpdatedAt is int
        && request.resource.data.updatedAt == request.time
        && request.resource.data.crmData is map
        && request.resource.data.crmData.leads is list;
    }

    function entitlementPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/entitlements/limits;
    }

    function maxScans(userId) {
      return exists(entitlementPath(userId))
        && get(entitlementPath(userId)).data.maxScansPerDay is int
        && get(entitlementPath(userId)).data.maxScansPerDay >= 10
        ? get(entitlementPath(userId)).data.maxScansPerDay
        : 10;
    }

    function startsNewScanWindow() {
      return request.resource.data.scanCount == 1
        && request.resource.data.windowStartedAt is timestamp
        && request.resource.data.windowStartedAt <= request.time
        && request.resource.data.windowStartedAt >= request.time - duration.value(1, 'm');
    }

    function incrementsActiveScanWindow(userId) {
      return 'windowStartedAt' in resource.data
        && resource.data.windowStartedAt is timestamp
        && request.time < resource.data.windowStartedAt + duration.value(24, 'h')
        && request.resource.data.windowStartedAt == resource.data.windowStartedAt
        && request.resource.data.scanCount == resource.data.scanCount + 1
        && request.resource.data.scanCount <= maxScans(userId);
    }

    function resetsExpiredScanWindow() {
      return (!('windowStartedAt' in resource.data)
          || (resource.data.windowStartedAt is timestamp
            && request.time >= resource.data.windowStartedAt + duration.value(24, 'h')))
        && startsNewScanWindow();
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /banks/{bankId} {
        allow read: if hasHistoricalWorkspaceReadAccess(userId);
        allow write: if hasPremiumWorkspaceAccess(userId);
      }

      match /bets/{betId} {
        allow read: if hasHistoricalWorkspaceReadAccess(userId);
        allow write: if hasPremiumWorkspaceAccess(userId);
      }

      match /balances/{balanceId} {
        allow read: if hasHistoricalWorkspaceReadAccess(userId);
        allow write: if hasPremiumWorkspaceAccess(userId);
      }

      match /preferences/customOptions {
        allow read, write: if isOwner(userId);
      }

      match /preferences/usageLimits {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && startsNewScanWindow()
          && request.resource.data.scanCount <= maxScans(userId);
        allow update: if isOwner(userId)
          && (incrementsActiveScanWindow(userId) || resetsExpiredScanWindow());
        allow delete: if false;
      }

      match /entitlements/{entitlementId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /appBonos/{documentId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && documentId == 'state'
          && isValidAppBonosState();
      }
    }

    match /admin/appBonosCrm {
      allow read, delete: if isMoneyTipsAdmin();
      allow create, update: if isMoneyTipsAdmin()
        && isValidAdminCrm();
    }

    // El ledger oficial no se expone directamente por Firestore: las lecturas
    // públicas se sirven saneadas mediante /api/official-picks y solo Admin SDK escribe.
    // Así ningún navegador puede crear, editar o eliminar un pick oficial.
    match /officialPicks/{officialPickId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read, write: if false;
      }
    }

    // Registro privado que vincula un snapshot público con su propietario.
    // El UID no se expone dentro del documento público.
    match /shareOwners/{shareId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if isValidShareOwner();
      allow update, delete: if false;
    }

    // Snapshots inmutables y saneados. Nunca apuntan directamente a /users.
    match /publicShares/{shareId} {
      allow read: if true;
      allow create: if ownsShareAfterWrite(shareId) && isValidPublicShare();
      allow update, delete: if false;

      match /bets/{betId} {
        allow read: if true;
        allow create: if ownsShare(shareId) && isValidPublicBet();
        allow update, delete: if false;
      }
    }

    // ─── Colecciones exclusivas del Admin SDK (servidor) ───
    // Ningún navegador puede leer, crear, editar o eliminar estos documentos.
    // Toda la escritura se realiza desde Vercel Serverless Functions con
    // credenciales de servicio de Firebase Admin.

    // Pedidos de pago creados por el checkout de PremiumPay.
    match /premiumPaymentOrders/{orderId} {
      allow read, write: if false;
    }

    // Sesiones sandbox de Stripe: Admin SDK únicamente.
    match /stripeCheckoutOrders/{orderId} {
      allow read, write: if false;
    }

    // Ledger de facturación: append-only mediante Admin SDK. Nunca expone
    // payloads de proveedor, tokens ni referencias de pago al navegador.
    match /billingEvents/{eventId} {
      allow read, write: if false;
    }

    // Bus central de eventos inmutables (auditoría append-only).
    match /systemEvents/{eventId} {
      allow read, write: if false;
    }

    // Estado de unidades operativas para Money Tips HQ.
    match /agentStates/{agentId} {
      allow read, write: if false;
    }

    // Incidencias de pagos y suscripciones (escalado a Ops - Customers & Revenue).
    match /revenueIncidents/{incidentId} {
      allow read, write: if false;
    }

    // Incidencias operativas de departamentos técnicos (Data & Performance, etc.).
    match /operationsIncidents/{incidentId} {
      allow read, write: if false;
    }

    // Tareas durables de auto-copia de picks oficiales a bancas de temporada.
    match /officialPickAutoCopyQueue/{taskId} {
      allow read, write: if false;
    }

    // Preflights de picks oficiales (expectativas T-5 / auditoría interna).
    match /officialPickPreflight/{preflightId} {
      allow read, write: if false;
    }

    // Registro interno de picks paper (stake 0, sin difusión ni banca).
    match /paperPicks/{pickId} {
      allow read, write: if false;
    }
  }
}
